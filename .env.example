DATABASE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cloudcord.xohus.lol/v1/oauth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORECLOUD_ENCRYPTION_KEY=
SESSION_SECRET=
GITHUB_PAT=
# Optional separate fine-grained token with read access to xohus/realcord.
# When omitted, the updater uses GITHUB_PAT.
REALCORD_GITHUB_PAT=
REALCORD_OWNER_KEY=
# Comma-separated paid license keys. REALCORD-* licenses accepted by the client
# remain valid even when this list is empty.
REALCORD_LICENSE_KEYS=
