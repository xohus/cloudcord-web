DATABASE_URL=
# Leave disabled for an internal Docker/Coolify database. Use "require" only
# when your external PostgreSQL provider requires TLS.
DATABASE_SSL=disable
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cloudcord.xohus.lol/v1/oauth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORECLOUD_ENCRYPTION_KEY=
SESSION_SECRET=
CLOUDCORD_DISCORD_CLIENT_ID=
CLOUDCORD_DISCORD_CLIENT_SECRET=
CLOUDCORD_DISCORD_BOT_TOKEN=
CLOUDCORD_DISCORD_GUILD_ID=
CLOUDCORD_DISCORD_REDIRECT_URI=https://cloudcord.xohus.lol/discord/join/callback
# Generate with 32 random bytes encoded as base64.
CLOUDCORD_MEMBERSHIP_SESSION_SECRET=
GITHUB_PAT=
# Optional separate fine-grained token with read access to xohus/realcord.
# When omitted, the updater uses GITHUB_PAT.
REALCORD_GITHUB_PAT=
# Comma-separated or JSON-array paid license keys. Never exposed to clients.
REALCORD_LICENSE_KEYS=
# Preferred: comma-separated or JSON-array SHA-256 hashes of paid keys.
REALCORD_LICENSE_HASHES=
# Comma-separated duration/hash pairs. Activation begins on first redemption.
# Example: 7d,sha256hash,30d,sha256hash,lifetime,sha256hash
REALCORD_LICENSE_RECORDS=
